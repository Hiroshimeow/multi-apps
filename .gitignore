# Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/

# Build outputs
build/
dist/
wheels/
*.egg-info/

# Runtime output
.runtime/
logs/
*.log
*.tmp
*.bak

# Local environment and editor files
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local analysis/review artifacts
.gitnexus/
*_review_artifact/

# Local archives
*.zip
*.7z

# Bundled tools: track source, ignore machine-local state and external nested repos.
/tools/*
!/tools/copy-content/
!/tools/copy-content/copy-content.py
!/tools/copy-content/README.md
/tools/copy-content/copy-content-config.json
/tools/copy-content/copy-content.txt
/tools/copy-content/thesis.txt
/tools/copy-content/logs/
/tools/copy-content/__pycache__/
/tools/advance-clipboard/
/tools/*_review_artifact/
/tools/search.txt

# Machine-local planning and active configuration
/.plan/
/setting.yaml
